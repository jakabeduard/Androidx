<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.tasty.recipesapp.ui.home.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.tasty.recipesapp.ui.profile.ProfileFragment"
        android:label="fragment_profile"
        tools:layout="@layout/fragment_profile" />
    <fragment
        android:id="@+id/recipesFragment"
        android:name="com.tasty.recipesapp.ui.recipes.RecipesFragment"
        android:label="fragment_recipes"
        tools:layout="@layout/fragment_recipes" >
        <action
            android:id="@+id/action_recipesFragment_to_recipesDetailFragment"
            app:destination="@id/recipesDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/recipesDetailFragment"
        android:name="com.tasty.recipesapp.ui.recipes.RecipesDetailFragment"
        android:label="fragment_recipes_detail"
        tools:layout="@layout/fragment_recipes_detail" />

</navigation>